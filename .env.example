# BÁNH MÌ 0 - SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE

# ----------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# ----------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------
# Development default: SQLite (zero complex setup)
DATABASE_TYPE=sqlite
DATABASE_FILE=./database/banhmi0.sqlite

# Production optional: PostgreSQL
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://postgres:password@localhost:5432/banhmi0_prod

# ----------------------------------------------------
# AUTHENTICATION & SECURITY
# ----------------------------------------------------
# Generate strong secrets with: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=7d

# ----------------------------------------------------
# INITIAL ADMIN BOOTSTRAP (SAFE SYSTEM INITIALIZATION)
# ----------------------------------------------------
# Used only during initial seed if no admin exists
ADMIN_BOOTSTRAP_EMAIL=admin@banhmi0.vn
ADMIN_BOOTSTRAP_PASSWORD=BanhMi0@Admin2026!
ADMIN_BOOTSTRAP_NAME=Quản Trị Viên BÁNH MÌ 0
ADMIN_BOOTSTRAP_PHONE=0901234567

# ----------------------------------------------------
# STORE & OPERATIONS SETTINGS
# ----------------------------------------------------
STORE_NAME="BÁNH MÌ 0"
STORE_SLOGAN="TRÒN VỊ MỖI NGÀY – NÓNG GIÒN TỪNG Ổ"
STORE_PHONE="0987654321"
STORE_ADDRESS="123 Đường Bánh Mì, Quận 1, TP. Hồ Chí Minh"
ENABLE_INVENTORY_AUTO_DEDUCT=true
DEDUCT_INVENTORY_ON_STATUS="CONFIRMED" # Options: CONFIRMED, PREPARING
